<% layout('/layouts/boilerplate') -%>

<style>
    /* --- Premium Modern Login Forms Custom Styles --- */
    .login-container {
        margin-top: 4rem;
        margin-bottom: 4rem;
    }
    .login-card-wrapper {
        background: #ffffff;
        border: 1px solid #dddddd;
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 6px 16px rgba(0,0,0,0.1);
    }
    /* Mobile view par card ki border aur shadow hatayein taaki clean lage */
    @media (max-width: 575.98px) {
        .login-card-wrapper {
            border: none;
            box-shadow: none;
            padding: 1rem;
        }
    }
    .form-label {
        font-weight: 600;
        color: #222222;
    }
    .form-control {
        border-radius: 8px !important;
        padding: 12px;
        /* border: 1px solid #b0b0b0 !important; */
        color: #222222 !important;
    }
    
    /* 🎯 Focus state styling (Red border block override) */
    .form-control:focus {
        border-color: #ff385c !important; /* Premium Airbnb Pink Focus */
        background-color: #ffffff !important;
        color: #222222 !important;
        outline: none !important;
        box-shadow: 0 0 0 0.2rem rgba(255, 56, 92, 0.25) !important;
    }

    .form-control:invalid {
        box-shadow: none !important;
    }
    
    .btn-airbnb {
        background-color: #ff385c !important;
        border: none !important;
        color: white !important;
        padding: 12px;
        border-radius: 8px !important;
        font-weight: 600;
        font-size: 1rem;
        width: 100%; /* Button full width rahega elegant look ke liye */
        transition: background-color 0.2s ease;
    }
    .btn-airbnb:hover {
        background-color: #e61e4d !important;
    }
</style>

<!-- 🎯 Main Centered Grid: Mobile par compact box aur centered alignment -->
<div class="container login-container">
    <div class="row justify-content-center">
        <!-- Offset removed: Desktop par perfect 5-column space aur mobile par 11-column space -->
        <div class="col-lg-5 col-md-7 col-11 login-card-wrapper">
            
            <h2 class="mb-4 text-dark fw-bold text-center">
                <i class="fa-solid fa-right-to-bracket me-2 text-danger"></i>Login to Airbnb
            </h2>
            
            <form method="post" action="/login" novalidate class="needs-validation">
          
                <!-- Username Field -->
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input type="text" id="username" required placeholder="Enter username" name="username" class="form-control">
                    <div class="invalid-feedback">Please enter your username.</div>
                </div>

                <!-- Password Field -->
                <div class="mb-4">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" id="password" minlength="5" required placeholder="Enter your password" name="password" class="form-control">
                    <div class="invalid-feedback">Please enter your password (minimum 5 characters).</div>
                </div>

                <!-- Airbnb Style Pink Login Button -->
                <button class="btn btn-airbnb mb-2" type="submit">Login</button>
                
                <div class="text-center mt-3">
                    <span class="text-muted small">Don't have an account? <a href="/signup" class="text-dark fw-bold text-decoration-underline">Sign up</a></span>
                </div>
            </form>
            
        </div>
    </div>
</div>
